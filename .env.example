# GEMINI_API_KEY: Required for optional anonymized Gemini AI audit calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet or frontend is hosted.
APP_URL="MY_APP_URL"

# Backend gateway settings (standalone or combined mode)
PORT=3000
SERVE_FRONTEND=true
ALLOWED_ORIGIN="*"
LICENSE_SIGNING_SECRET=""

# Separated Frontend -> Backend API base URL (leave empty when served from same origin)
VITE_API_BASE_URL=""
